# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Service Role Key is used purely on the Next.js server to bypass RLS and perform secure operations.
# NEVER expose this key to client-side code or the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Public URL (for client-side reference if needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Device Security
# Shared secret token for the NodeMCU ESP8266.
# The NodeMCU must send this in the header: "Authorization: Bearer <DEVICE_TOKEN>"
DEVICE_TOKEN=your_secure_random_device_token_here

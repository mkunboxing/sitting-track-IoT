# Frontend (Next.js) configuration
# Base URL of the Express backend (server/ directory).
# Leave empty to use the same origin; in dev with the backend on :4000 use:
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── The variables below moved to server/.env.example ──────────
# The Next.js app no longer talks to Supabase or validates device tokens.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and DEVICE_TOKEN are read by the
# Express backend — see server/.env.example.

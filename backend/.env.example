# Supabase (server-side, service role — bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── User accounts (dashboard auth — separate from device/MQTT auth) ──────────
# Used by scripts/migrate-auth.ts to create the default test/admin account
# and assign all pre-existing sitting sessions to it. Passwords are always
# stored bcrypt-hashed (never plaintext). Leave ADMIN_PASSWORD unset to use
# the default "admin123".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Express server
PORT=4000
# Comma-separated list of allowed origins for CORS (the Next.js frontend origin).
# Use * to allow ANY origin (fine for development; prefer explicit origins in production).
# Examples:
#   CORS_ORIGIN=*
#   CORS_ORIGIN=http://localhost:3000
#   CORS_ORIGIN=http://localhost:3000,https://smart-tracking.vercel.app
CORS_ORIGIN=*

# ── MQTT (EMQX Cloud) — device telemetry + session events ───────────────────
# The backend subscribes to the device topics over MQTT over TLS. Telemetry
# snapshots feed the shared telemetry pipeline; confirmed session events
# (SESSION_STARTED/SESSION_ENDED, QoS 1) are processed idempotently by
# lib/sessionEvents.ts. Leaving MQTT_BROKER_URL unset disables MQTT entirely.
#
# Persistent session: the backend connects with a STABLE client id,
# clean: false and a sessionExpiryInterval (MQTT 5), so EMQX keeps the
# session while the backend is offline (Render deploy/crash) and queues the
# QoS 1 session events for replay on reconnect. Telemetry (QoS 0) is not
# buffered — it stays fire-and-forget as before.
#
# Get these from the EMQX Cloud console → your deployment → "Connection info":
#   host = the mqtts:// host, port 8883 (TLS)
#   username/password = create under "Access Management" → "Authentication"
MQTT_BROKER_URL=mqtts://your-deployment.ala.asia-southeast1.emqxsl.com:8883
MQTT_USERNAME=your-emqx-username
MQTT_PASSWORD=your-emqx-password

# Optional — sensible defaults shown:
#   client id — MUST stay stable across restarts (the persistent session and
#   EMQX's offline event queue are keyed on it). If you ever run TWO backend
#   instances against the same broker at once (e.g. local dev + Render while
#   testing), give each a distinct value or they will keep stealing each
#   other's session.
#MQTT_CLIENT_ID=smart-tracking-backend
#   subscriptions (wildcard matches every device)
#MQTT_TELEMETRY_TOPIC=sitting/device/+/telemetry
#MQTT_STATUS_TOPIC=sitting/device/+/status
#MQTT_EVENTS_TOPIC=sitting/device/+/events
#   how long (seconds) the broker keeps the offline session + queued events
#   while the backend is down (default 7 days)
#MQTT_SESSION_EXPIRY=604800
#   device id for the mobile app's session-state topic
#   sitting/device/<DEVICE_ID>/session (retained, QoS 1 — active session,
#   previous session, date-aware today totals). Same id the firmware and the
#   simulator use; single-device system.
#DEVICE_ID=sitting-tracker-01
#   IANA timezone used to compute "today" for the MQTT session-state totals
#   and the midnight rollover (the dashboard sends its timezone per request,
#   but MQTT has no request context). Defaults to the server's local zone —
#   on Render that is UTC, so set this to your home timezone.
#APP_TIMEZONE=Asia/Kolkata
#   custom CA bundle (PEM) for a private CA. "\n" escapes are unescaped.
#   EMQX Cloud's certificate chains to DigiCert Global Root G2 — Node's
#   built-in roots already trust it, so this is only needed for brokers
#   with a private CA.
#MQTT_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
